---
const { destaque } = Astro.props;
---

<!-- O wrapper recebe a animação de "aparecer ao rolar"; o .cartao recebe a inclinação 3D -->
<div class="cartao-wrap" data-reveal>
  <div class:list={['cartao', { 'cartao-destaque': destaque }]}>
    <span class="cartao-luz" aria-hidden="true"></span>
    <div class="cartao-conteudo">
      <slot />
    </div>
  </div>
</div>

<style>
  .cartao-wrap {
    height: 100%;
  }

  .cartao {
    position: relative;
    height: 100%;
    overflow: hidden;
    background-color: var(--cor-fundo);
    border: 1px solid var(--cor-borda);
    border-radius: var(--borda-raio);
    padding: 2rem;
    box-shadow: var(--sombra-cartao);
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg))
      translateY(var(--sobe, 0px));
    transition: transform 0.25s ease-out, box-shadow 0.3s ease, border-color 0.3s ease;
    will-change: transform;
  }

  .cartao:hover {
    --sobe: -6px;
    box-shadow: var(--sombra-cartao-hover);
    border-color: rgba(31, 176, 232, 0.55);
  }

  /* Luz azul que acompanha o mouse dentro do cartão */
  .cartao-luz {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    background: radial-gradient(
      380px circle at var(--x, 50%) var(--y, 50%),
      rgba(31, 176, 232, 0.17),
      transparent 55%
    );
  }

  .cartao:hover .cartao-luz {
    opacity: 1;
  }

  .cartao-conteudo {
    position: relative;
  }

  /* Cartão com faixa em degradê no topo */
  .cartao-destaque::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--degrade-marca-vivo);
    background-size: 200% 100%;
    animation: fluxo 6s linear infinite;
  }
</style>
