---
// Banner escuro e animado usado no topo das páginas internas
const { rotulo, titulo, texto } = Astro.props;
---

<section class="banner escuro" data-hero>
  <canvas class="hero-canvas" data-particulas data-densidade="baixa" aria-hidden="true"></canvas>
  <div class="hero-grade" aria-hidden="true"></div>
  <div class="hero-brilho" aria-hidden="true"></div>

  <div class="container banner-conteudo">
    {rotulo && (
      <span class="selo"><span class="selo-ponto"></span>{rotulo}</span>
    )}
    <h1>{titulo}</h1>
    {texto && <p class="banner-texto">{texto}</p>}
  </div>
</section>

<style>
  .banner {
    background: var(--degrade-hero);
    padding: 5.5rem 0 5rem;
  }

  .banner-conteudo h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin-bottom: 1rem;
    animation: entrar 0.9s var(--ease) both;
  }

  .banner-conteudo .selo {
    animation: entrar 0.9s var(--ease) both;
  }

  .banner-texto {
    max-width: 640px;
    font-size: 1.2rem;
    color: var(--cor-texto-invertido-suave);
    margin-bottom: 0;
    animation: entrar 0.9s 0.15s var(--ease) both;
  }

  @keyframes entrar {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
</style>
