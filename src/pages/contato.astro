---
import LayoutBase from '../layouts/LayoutBase.astro';
import Cartao from '../components/Cartao.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import { empresa } from '../data/empresa.js';

const telefoneLimpo = empresa.contato.telefone.replace(/\D/g, '');
---

<LayoutBase
  titulo="Fale Conosco"
  descricao={`Entre em contato com a ${empresa.nome}.`}
>
  <CabecalhoPagina
    rotulo="Contato"
    titulo="Fale Conosco"
    texto={`Precisa de uma solução tecnológica para o seu negócio? Entre em contato com a ${empresa.nome}!`}
  />

  <section class="secao">
    <div class="container">
      <div class="grid-contato">
        <Cartao>
          <span class="icone">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" /></svg>
          </span>
          <h2>Nossa Sede</h2>
          <address>
            {empresa.contato.endereco.logradouro}<br />
            {empresa.contato.endereco.bairro}<br />
            {empresa.contato.endereco.cidadeEstado}
          </address>
        </Cartao>

        <Cartao>
          <span class="icone">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
          </span>
          <h2>E-mail</h2>
          <p><a href={`mailto:${empresa.contato.email}`}>{empresa.contato.email}</a></p>
        </Cartao>

        <Cartao>
          <span class="icone">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" /></svg>
          </span>
          <h2>Telefone</h2>
          <p><a href={`tel:+55${telefoneLimpo}`}>{empresa.contato.telefone}</a></p>
        </Cartao>
      </div>

      <div class="acao" data-reveal>
        <a href={`mailto:${empresa.contato.email}`} class="btn">
          Enviar e-mail
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </section>
</LayoutBase>

<style>
  .grid-contato {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
  }

  .grid-contato h2 {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
    color: var(--cor-primaria);
  }

  address {
    font-style: normal;
    color: var(--cor-texto-secundario);
  }

  .grid-contato p {
    margin-bottom: 0;
    word-break: break-word;
  }

  .icone {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 1.25rem;
    border-radius: 14px;
    color: #fff;
    background: linear-gradient(135deg, var(--cor-secundaria), var(--cor-azul-vivo));
    box-shadow: 0 10px 24px -10px rgba(31, 176, 232, 0.9);
  }

  .icone svg {
    width: 26px;
    height: 26px;
  }

  .acao {
    margin-top: 3rem;
    text-align: center;
  }
</style>
