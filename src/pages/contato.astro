---
import LayoutBase from '../layouts/LayoutBase.astro';
import Cartao from '../components/Cartao.astro';
import { empresa } from '../data/empresa.js';

const telefoneLimpo = empresa.contato.telefone.replace(/\D/g, '');
---

<LayoutBase
  titulo="Fale Conosco"
  descricao={`Entre em contato com a ${empresa.nome}.`}
>
  <!-- Fachada institucional Nextage -->
  <section class="contato-hero">
    <div class="hero-overlay"></div>

    <div class="container hero-container">
      <div class="hero-conteudo" data-reveal>
        <span class="hero-rotulo">
          <span class="ponto"></span>
          Contato
        </span>

        <h1>Fale Conosco</h1>

        <p>
          Precisa de uma solução tecnológica para o seu negócio?
          Entre em contato com a {empresa.nome}!
        </p>
      </div>
    </div>
  </section>

  <!-- Informações de contato -->
  <section class="secao">
    <div class="container">
      <div class="grid-contato">

        <Cartao>
          <span class="icone">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>
          </span>

          <h2>Nossa Sede</h2>

          <address>
            {empresa.contato.endereco.logradouro}<br />
            {empresa.contato.endereco.bairro}<br />
            {empresa.contato.endereco.cidadeEstado}
          </address>
        </Cartao>

        <Cartao>
          <span class="icone">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          </span>

          <h2>E-mail</h2>

          <p>
            <a href={`mailto:${empresa.contato.email}`}>
              {empresa.contato.email}
            </a>
          </p>
        </Cartao>

        <Cartao>
          <span class="icone">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" />
            </svg>
          </span>

          <h2>Telefone</h2>

          <p>
            <a href={`tel:+55${telefoneLimpo}`}>
              {empresa.contato.telefone}
            </a>
          </p>
        </Cartao>

      </div>

      <div class="acao" data-reveal>
        <a href={`mailto:${empresa.contato.email}`} class="btn">
          Enviar e-mail

          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</LayoutBase>

<style>
  /* FACHADA NEXTAGE CORPORATION */

  .contato-hero {
    position: relative;
    min-height: 420px;
    display: flex;
    align-items: center;
    overflow: hidden;

    background-image: url('/images/nextage-fachada.png');
    background-size: cover;
    background-position: center 48%;
    background-repeat: no-repeat;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        90deg,
        rgba(5, 19, 45, 0.94) 0%,
        rgba(7, 32, 68, 0.78) 48%,
        rgba(8, 48, 91, 0.30) 100%
      );
  }

  .hero-container {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .hero-conteudo {
    max-width: 700px;
  }

  .hero-rotulo {
    display: inline-flex;
    align-items: center;
    gap: 10px;

    padding: 9px 17px;
    margin-bottom: 22px;

    color: #d9e8fa;
    background: rgba(255, 255, 255, 0.09);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 30px;

    font-size: 0.9rem;
    font-weight: 600;
    backdrop-filter: blur(8px);
  }

  .ponto {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #28d7ee;
    box-shadow: 0 0 12px #28d7ee;
  }

  .hero-conteudo h1 {
    color: #ffffff;
    font-size: clamp(2.5rem, 5vw, 3.6rem);
    line-height: 1.1;
    font-weight: 800;
    margin: 0 0 20px;
    letter-spacing: -1.5px;
  }

  .hero-conteudo p {
    color: #d0dbea;
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.65;
    max-width: 650px;
    margin: 0;
  }

  /* CARTÕES DE CONTATO */

  .grid-contato {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
  }

  .grid-contato h2 {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
    color: var(--cor-primaria);
  }

  address {
    font-style: normal;
    color: var(--cor-texto-secundario);
  }

  .grid-contato p {
    margin-bottom: 0;
    word-break: break-word;
  }

  .icone {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 1.25rem;
    border-radius: 14px;
    color: #fff;

    background: linear-gradient(
      135deg,
      var(--cor-secundaria),
      var(--cor-azul-vivo)
    );

    box-shadow: 0 10px 24px -10px rgba(31, 176, 232, 0.9);
  }

  .icone svg {
    width: 26px;
    height: 26px;
  }

  .acao {
    margin-top: 3rem;
    text-align: center;
  }

  /* RESPONSIVIDADE PARA CELULARES */

  @media (max-width: 768px) {
    .contato-hero {
      min-height: 360px;
      background-position: 58% center;
    }

    .hero-overlay {
      background: linear-gradient(
        90deg,
        rgba(5, 19, 45, 0.94),
        rgba(5, 25, 55, 0.72)
      );
    }

    .hero-container {
      padding-top: 4rem;
      padding-bottom: 4rem;
    }

    .hero-conteudo h1 {
      font-size: 2.5rem;
    }

    .hero-conteudo p {
      font-size: 1rem;
    }

    .grid-contato {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>